{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar Taller en Ventana Windows (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "args": ["."],
      "preLaunchTask": "3. Compilar Desktop (Web + Servidor)"
    },
    {
      "name": "Ejecutar Servidor Web (Desarrollo)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "server.ts"],
      "console": "integratedTerminal"
    }
  ]
}
