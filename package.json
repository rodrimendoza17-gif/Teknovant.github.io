{
  "name": "teknovant-labs-taller",
  "private": true,
  "version": "1.0.0",
  "description": "Teknovant Labs - Administrador de Taller, Cotizador IA y WhatsApp",
  "author": "Teknovant Labs",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:desktop": "npm run build && npm run build:server",
    "desktop:dev": "npm run build:desktop && npx electron .",
    "desktop:exe": "npm run build:desktop && npx electron-builder --win nsis portable --x64 --config electron-builder.yml",
    "desktop:msi": "npm run build:desktop && npx electron-builder --win msi --x64 --config electron-builder.yml",
    "desktop:all": "npm run build:desktop && npx electron-builder --win nsis portable msi --x64 --config electron-builder.yml",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "libsignal": "6.0.0"
  }
}
