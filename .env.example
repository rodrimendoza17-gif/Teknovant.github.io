# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# ANTHROPIC_API_KEY: Optional Anthropic Claude API key for market quoting with Claude.
ANTHROPIC_API_KEY=""

# ADMIN_PASSCODE: Optional fixed administrator password/passcode.
# Leave empty to configure your admin password on first login.
ADMIN_PASSCODE=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""
