# Motor de IA preferido por defecto (auto | gemini | groq | openai | openrouter | claude | deepseek | custom)
AI_PROVIDER="auto"

# 1) Google Gemini (Gratis en https://aistudio.google.com/apikey -> empieza con AIza...)
GEMINI_API_KEY=""

# 2) Groq Cloud (Gratis y muy rápido en https://console.groq.com/keys -> empieza con gsk_...)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3) OpenAI / ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 4) OpenRouter (Modelos gratis y de pago en https://openrouter.ai/keys)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 5) Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# 6) DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# 7) Cualquier otra API compatible con OpenAI (Ollama local, LM Studio, Mistral, Together, etc.)
# Ejemplo Ollama local: CUSTOM_AI_BASE_URL="http://127.0.0.1:11434/v1" y CUSTOM_AI_MODEL="llama3.2"
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""

# ADMIN_PASSCODE: Contraseña fija opcional para el Administrador (si se deja vacío se crea en el primer inicio)
ADMIN_PASSCODE=""

# APP_URL: URL pública donde está alojada la app
APP_URL=""
